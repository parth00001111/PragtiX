PORT=5001
NODE_ENV=development

# Comma-separated origins are supported in deployed environments.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Generate different, strong random values for these secrets.
ACCESS_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Prisma/PostgreSQL connection values, when Prisma-backed modules are enabled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Gemini credentials belong in backend/.env locally and Render Environment in production.
# Never put a real API key in this example file.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_CHAT_MODEL=gemini-2.5-flash
