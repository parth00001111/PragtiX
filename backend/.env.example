PORT=5001
NODE_ENV=development

# Comma-separated origins are supported in deployed environments.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Generate different, strong random values for these secrets.
ACCESS_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# PostgreSQL is required for the backend.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional AI. Disabled until explicitly configured.
AI_PROVIDER=disabled
AI_MODEL=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
